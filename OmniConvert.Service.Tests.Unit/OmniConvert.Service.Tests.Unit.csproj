    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniConvert.Service.Application\OmniConvert.Service.Application.csproj" />
    <ProjectReference Include="..\OmniConvert.Service.Core\OmniConvert.Service.Core.csproj" />
  </ItemGroup>
